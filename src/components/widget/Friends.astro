---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;

const friends = [
	{
		name: "Flávio",
		url: "https://frav.in",
		githubUrl: "https://github.com/flaviozanoni",
	},
	{
		name: "Mulling",
		url: "https://hacking.tunalinux.org",
		githubUrl: "https://github.com/mulling",
	},
	{
		name: "Pablo",
		url: "https://tomcat0x42.me",
		githubUrl: "https://github.com/tomcat-42",
	},
	{
		name: "Nunes",
		url: "https://numnes.com",
		githubUrl: "https://github.com/numnes",
	},
	{
		name: "Matozinho",
		url: "https://matozinho-github-io.vercel.app/",
		githubUrl: "https://github.com/matozinho",
	},
];
---

<WidgetLayout name="GNUssy members" id="friends" class={className} style={style}>
    {friends.map((friend) => (
        <div class="flex items-center justify-between h-10 px-2 rounded-lg transition-all
            hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]">
            <span class="text-neutral-700 dark:text-neutral-300 hover:text-[var(--primary)] transition-colors">
                {friend.name}
            </span>
            <div class="flex gap-2">
                <a href={friend.url} target="_blank" rel="noopener noreferrer" 
                   class="btn-regular h-8 w-8 rounded-lg flex items-center justify-center transition-all hover:text-[var(--primary)]"
                   aria-label={`Visit ${friend.name}'s website`}>
                    <Icon name="material-symbols:public" class="text-xl" />
                </a>
                <a href={friend.githubUrl} target="_blank" rel="noopener noreferrer"
                   class="btn-regular h-8 w-8 rounded-lg flex items-center justify-center transition-all hover:text-[var(--primary)]"
                   aria-label={`Visit ${friend.name}'s GitHub profile`}>
                    <Icon name="fa6-brands:github" class="text-xl" />
                </a>
            </div>
        </div>
    ))}
</WidgetLayout>